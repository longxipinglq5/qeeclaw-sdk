# Bridge BFF 环境变量
# 复制为 .env 后填入真实值
#
# 云端模型/platform base url 固定为 https://paas.qeeshu.com，不支持配置覆盖。
# key 优先级: provisioning runtime.env > 设备 env > 本地 .env
# Standalone 包通过 run.sh 注入 QEECLAW_* 环境变量
CENTAUR_MODEL_API_KEY=
NEXUS_API_KEY=

# ========================
# 服务端监听
# ========================
# 开发模式用 BRIDGE_PORT；standalone 包用 QEECLAW_HERMES_BRIDGE_PORT
# BRIDGE_PORT=8787
# QEECLAW_HERMES_BRIDGE_PORT=21747
# QEECLAW_HERMES_BRIDGE_HOST=0.0.0.0

# ========================
# LLM Provider
# ========================
HERMES_MODEL=deepseek-chat
# 兼容旧配置：如果没有 CENTAUR_MODEL_API_KEY/NEXUS_API_KEY，会读取 DEEPSEEK_API_KEY 作为本地兜底 key。
DEEPSEEK_API_KEY=

# ========================
# Bridge 配置
# ========================
BRIDGE_LOG_LEVEL=INFO
# BRIDGE_RELOAD=1

# ========================
# Hermes Agent 路径
# ========================
# 默认自动检测 vendor/hermes-agent worktree 或 standalone 包内的 vendor/hermes-agent
# HERMES_AGENT_DIR=
# QEECLAW_HERMES_AGENT_DIR=

# ========================
# Hermes Home（standalone 包默认 data/hermes）
# ========================
# HERMES_HOME=

# ========================
# 配置文件路径 (standalone 包通过 run.sh 注入)
# ========================
# QEECLAW_CONFIG_FILE=config.yaml

# ========================
# 知识库配置
# ========================
# QEECLAW_KB_DIR=data/knowledge
# QEECLAW_KB_EMBEDDING_MODEL_FILE=models/Qwen3-Embedding-0.6B-Q4_0.gguf
